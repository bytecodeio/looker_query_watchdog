{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Watchdog: Trigger Once",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cloud_function/trigger_once.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/cloud_function",
      "justMyCode": true
    },
    {
      "name": "Watchdog: Trigger Loop",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/cloud_function/trigger_loop.py",
      "args": ["--interval", "5", "--duration", "6"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}/cloud_function",
      "justMyCode": true
    }
  ]
}
